# =============================================================
#  kor-welfare-hub — 외부 API 키 모음
# =============================================================
# 사용법
#   1) 파일명을 .env.local 로 복사 (이 파일 자체는 그대로 두세요)
#   2) 각 키를 발급받아 = 우측에 붙여넣기
#   3) npm run dev 재시작 또는 npm run sync:<name>
#
# 모든 키는 비어있어도 동작합니다 (해당 소스만 비활성화).
# 한국 공공 API는 전부 무료이며 회원가입만 하면 즉시 발급됩니다.
# =============================================================


# ──────────────────────────────────────────────
# 1. 복지로 (한국사회보장정보원_사회보장급여 사업목록)
# ──────────────────────────────────────────────
# 신청: https://www.data.go.kr/data/15098570/openapi.do
#   → [활용신청] (자동승인, 즉시)
# 키 위치: 마이페이지 → 데이터활용 → "일반 인증키(Decoding)" 복사
# 호출 예상 건수: 5,000~9,000
BOKJIRO_API_KEY=


# ──────────────────────────────────────────────
# 2. 온통청년 (청년정책 통합검색)
# ──────────────────────────────────────────────
# 신청: https://www.youthcenter.go.kr/opi/openApiList.do
#   → 회원가입 → 좌측 [Open API 신청] → 사용목적 입력 → 즉시 발급
# 키 위치: 마이페이지 → Open API 인증키 (영문 18자리)
# 호출 예상 건수: 5,000~10,000
# 주의: data.go.kr가 아닌 youthcenter.go.kr 자체 발급 시스템
YOUTHCENTER_API_KEY=


# ──────────────────────────────────────────────
# 3. 정부24 (행정안전부_정부24 안내서비스)
# ──────────────────────────────────────────────
# 신청: https://www.data.go.kr/data/15090787/openapi.do  (생애주기별 안내)
#   또는: https://www.data.go.kr/data/15077048/openapi.do (서비스 안내)
#   → [활용신청] (일부 자동, 일부 1~3일 심사)
# 키 위치: 마이페이지 → 일반 인증키(Decoding)
# 호출 예상 건수: 1,000~3,000
GOV24_API_KEY=


# ──────────────────────────────────────────────
# 4. 워크넷 (고용노동부_채용정보 / 직업훈련)
# ──────────────────────────────────────────────
# 신청: https://www.work24.go.kr/cm/openApi/main.do
#   → 회원가입 → [인증키 발급신청] → 즉시 발급
# 키 위치: 마이페이지 → 인증키
# 호출 예상 건수: 500~2,000 (정책·훈련·채용 중 정책 위주 수집)
WORKNET_API_KEY=


# ──────────────────────────────────────────────
# 5. K-Startup (창업진흥원_창업지원사업)
# ──────────────────────────────────────────────
# 신청: https://www.data.go.kr/data/15121654/openapi.do
# 키 위치: 마이페이지 → 일반 인증키(Decoding)
KSTARTUP_API_KEY=


# ──────────────────────────────────────────────
# 6. 공공서비스 목록 (행정안전부_공공서비스)
# ──────────────────────────────────────────────
# 신청: https://www.data.go.kr/ → "공공서비스" 검색 → 활용신청
# 키 위치: 마이페이지 → 일반 인증키(Decoding)
GOV_SERVICE_API_KEY=


# ──────────────────────────────────────────────
# 7. Gemini (AI 추천 기능)
# ──────────────────────────────────────────────
# 발급: https://aistudio.google.com/apikey
# 비어 있으면 AI 추천 기능만 비활성화되고 나머지는 정상 동작합니다.
# ⚠ 이 키는 과금 대상입니다. ALLOWED_ORIGINS·AI_RATE_LIMIT_* 를 함께 설정하세요.
GEMINI_API_KEY=
# 선택: 기본값 gemini-2.5-flash
GEMINI_MODEL=


# ──────────────────────────────────────────────
# 8. 워크넷 부가 키 (WORKNET_ENABLE=true 일 때만 사용)
# ──────────────────────────────────────────────
# 엔드포인트 URL 확정 전까지 기본 비활성화 상태입니다.
WORKNET_ENABLE=false
WORKNET_HRD_KEY=
WORKNET_JOBSEEKER_KEY=


# =============================================================
#  보안 · 사용량 제어 (프로덕션에서 반드시 설정)
# =============================================================

# CORS 허용 오리진 (쉼표 구분).
#   - 비워두면: 데이터 API는 * 공개, /api/ai/* 는 동일 출처만 허용
#   - 앱인토스 미니앱을 쓴다면 해당 도메인을 여기에 나열하세요
# 앱인토스 운영·QR 테스트 도메인은 코드에 기본 등록되어 있습니다.
#   https://bokji.apps.tossmini.com
#   https://bokji.private-apps.tossmini.com
# 추가 웹 클라이언트가 있을 때만 아래에 쉼표로 구분해 입력하세요.
# 예) ALLOWED_ORIGINS=https://partner.example.com
ALLOWED_ORIGINS=

# /api/diag 와 /api/scrape?refresh=1 접근용 시크릿.
# 프로덕션에서 미설정 시 두 엔드포인트는 404를 반환합니다.
# 생성 예) openssl rand -hex 32
CRON_SECRET=

# AI 추천 호출 상한 (인스턴스 기준, 1시간 창)
AI_RATE_LIMIT_PER_IP=10
AI_RATE_LIMIT_GLOBAL=300


# =============================================================
#  토스 로그인 (앱인토스)
# =============================================================

# 연결 끊기 콜백의 Basic Auth 자격증명.
# 앱인토스 콘솔 > 토스 로그인 > 연결 끊기 콜백 정보 > Basic Auth 헤더
# 에 넣는 값과 반드시 같아야 해요.
#
# 생성 방법
#   1) 아이디/비밀번호를 정합니다 (비밀번호는 길고 무작위로)
#        PASS=$(openssl rand -hex 24)
#   2) 이 파일에는 "아이디:비밀번호" 형태로 넣습니다
#        TOSS_UNLINK_BASIC=toss:$PASS
#   3) 콘솔에는 base64 로 인코딩한 값을 넣습니다
#        printf 'toss:%s' "$PASS" | base64
#
# base64 값을 그대로 넣어도 동작합니다(자동 판별).
# 미설정 시 콜백은 모든 요청을 401 로 거부합니다.
TOSS_UNLINK_BASIC=

# 토스 로그인 서버 간 통신용 mTLS 인증서/개인키입니다.
# PEM 여러 줄은 Vercel 환경변수에 그대로 붙여넣거나 줄바꿈을 \\n 으로 넣을 수 있습니다.
TOSS_MTLS_CERT=
TOSS_MTLS_KEY=
TOSS_MTLS_PASSPHRASE=

# 앱인토스 콘솔에서 이메일로 받은 AES-256-GCM 복호화 키(base64)와 AAD.
TOSS_DECRYPTION_KEY=
TOSS_DECRYPTION_AAD=

# 로그인 세션 암호화용 32바이트 base64 키. 예: openssl rand -base64 32
TOSS_SESSION_SECRET=

# AIT 빌드 시 사용하는 값입니다. 앱인토스 콘솔 > 유저정보 불러오기에서
# 발급된 cud_... 키를 apps-in-toss/.env.local 에 같은 이름으로 설정하세요.
VITE_TOSS_USER_DATA_KEY=
